{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersader.github.io/cleanyfin/schema/v2/evidence-register.schema.json",
  "title": "Cleanyfin supplemental test playback register v2",
  "description": "R24 test playback only. Never eligible for full playback or v1 lab admission. One exact tuple per reviewed measurement; no wildcards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registerVersion",
    "rows"
  ],
  "properties": {
    "registerVersion": {
      "const": 2
    },
    "rows": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]*$(?![\\s\\S])"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 :.,/_-]*[A-Za-z0-9:.,/_-])?$(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$(?![\\s\\S])"
        },
        {
          "pattern": "\\S"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "videoCodec",
        "audioCodec",
        "trackLayout",
        "durationMs"
      ],
      "properties": {
        "container": {
          "$ref": "#/$defs/token"
        },
        "videoCodec": {
          "$ref": "#/$defs/token"
        },
        "audioCodec": {
          "enum": [
            "ac3",
            "eac3"
          ]
        },
        "trackLayout": {
          "$ref": "#/$defs/label"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterId",
        "adapterRevision",
        "appId",
        "appVersion",
        "appBuild",
        "backend",
        "deviceMode",
        "jellyfinVersion",
        "pluginBuild",
        "source"
      ],
      "properties": {
        "adapterId": {
          "$ref": "#/$defs/token"
        },
        "adapterRevision": {
          "$ref": "#/$defs/token"
        },
        "appId": {
          "$ref": "#/$defs/label"
        },
        "appVersion": {
          "$ref": "#/$defs/token"
        },
        "appBuild": {
          "$ref": "#/$defs/digest"
        },
        "backend": {
          "$ref": "#/$defs/token"
        },
        "deviceMode": {
          "$ref": "#/$defs/label"
        },
        "jellyfinVersion": {
          "$ref": "#/$defs/token"
        },
        "pluginBuild": {
          "$ref": "#/$defs/digest"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "limit"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "not-measured"
          ]
        },
        "limit": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markedPicture",
        "markedSound",
        "keptPictureAtJoin",
        "keptSoundAtJoin"
      ],
      "properties": {
        "markedPicture": {
          "$ref": "#/$defs/result",
          "properties": {
            "outcome": {
              "const": "pass"
            }
          }
        },
        "markedSound": {
          "$ref": "#/$defs/result",
          "properties": {
            "outcome": {
              "const": "pass"
            }
          }
        },
        "keptPictureAtJoin": {
          "$ref": "#/$defs/result"
        },
        "keptSoundAtJoin": {
          "$ref": "#/$defs/result"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tuple",
        "actions",
        "controls",
        "results",
        "evidenceRef",
        "date",
        "status",
        "observation",
        "tier",
        "gate",
        "seams"
      ],
      "properties": {
        "tuple": {
          "$ref": "#/$defs/tuple"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "cut"
          }
        },
        "controls": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "straight-play",
              "seek-forward",
              "seek-back",
              "resume",
              "restart"
            ]
          }
        },
        "results": {
          "$ref": "#/$defs/results"
        },
        "evidenceRef": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*\\.[A-Za-z0-9]+$(?![\\s\\S])"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
        },
        "status": {
          "const": "experimental"
        },
        "observation": {
          "$ref": "#/$defs/note"
        },
        "tier": {
          "const": "test"
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positions",
            "allTakesMeasured",
            "markedFrames",
            "markedSoundDetections",
            "positiveControlsPassed"
          ],
          "properties": {
            "positions": {
              "const": 24
            },
            "allTakesMeasured": {
              "const": true
            },
            "markedFrames": {
              "const": 0
            },
            "markedSoundDetections": {
              "const": 0
            },
            "positiveControlsPassed": {
              "const": true
            }
          }
        },
        "seams": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "silence",
            "pop",
            "keptPicture",
            "sync",
            "keptSoundLoss"
          ],
          "properties": {
            "silence": {
              "$ref": "#/$defs/note"
            },
            "pop": {
              "$ref": "#/$defs/note"
            },
            "keptPicture": {
              "$ref": "#/$defs/note"
            },
            "sync": {
              "$ref": "#/$defs/note"
            },
            "keptSoundLoss": {
              "$ref": "#/$defs/note"
            }
          }
        }
      }
    }
  }
}
