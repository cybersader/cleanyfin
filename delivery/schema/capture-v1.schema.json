{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersader.github.io/cleanyfin/schema/v1/capture.schema.json",
  "title": "Cleanyfin marking capture v1",
  "$comment": "One press while watching: fuzzy, append-only, never edited and never filters anything. Also apply strict runtime parsing. Schema does not check duplicate keys, lexical integer spelling, byte/depth limits, endAtMs > atMs, unique refs, author membership or the surface/role pairing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["captureVersion", "ref", "capturedAt", "author", "surface", "target", "clock", "kind", "atMs", "window"],
  "properties": {
    "captureVersion": {"const": 1},
    "ref": {"$ref": "#/$defs/ref"},
    "capturedAt": {"$ref": "#/$defs/utc"},
    "author": {"$ref": "#/$defs/ref"},
    "surface": {"enum": ["phone-remote", "review-page", "hotkey", "service"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverRef", "itemId", "mediaSourceId"],
      "properties": {
        "serverRef": {"$ref": "#/$defs/ref"},
        "itemId": {"$ref": "#/$defs/ref"},
        "mediaSourceId": {"$ref": "#/$defs/ref"}
      }
    },
    "clock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "source"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "planRev"],
          "properties": {"kind": {"const": "filtered"}, "planRev": {"$ref": "#/$defs/ref"}}
        }
      ]
    },
    "kind": {"enum": ["point", "span"]},
    "atMs": {"$ref": "#/$defs/nonnegative"},
    "endAtMs": {"$ref": "#/$defs/positive"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeMs", "afterMs"],
      "properties": {
        "beforeMs": {"$ref": "#/$defs/windowMs"},
        "afterMs": {"$ref": "#/$defs/windowMs"}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionPositionMs", "reportedAt", "paused"],
      "properties": {
        "sessionPositionMs": {"$ref": "#/$defs/nonnegative"},
        "reportedAt": {"$ref": "#/$defs/utc"},
        "paused": {"type": "boolean"}
      }
    },
    "category": {
      "$comment": "A quick phone category or a core category. A hint only; the reviewer sets the mark's category.",
      "enum": ["language", "violence", "sex_nudity", "other",
        "profanity", "sexual_dialogue", "sex_scene", "nudity", "gore", "disturbing", "substance_use", "crude"]
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 500, "$comment": "Household-private; never exported off the household."}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "span"}}}, "then": {"required": ["endAtMs"]}},
    {"if": {"properties": {"kind": {"const": "point"}}}, "then": {"not": {"required": ["endAtMs"]}}}
  ],
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"},
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,7})?Z(?![\\s\\S])"
    },
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "windowMs": {"type": "integer", "minimum": 0, "maximum": 600000}
  }
}
