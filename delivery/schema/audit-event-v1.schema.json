{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersader.github.io/cleanyfin/schema/v1/audit-event.schema.json",
  "title": "Cleanyfin household audit event v1",
  "$comment": "One line of a JSON Lines log per household decision. prev is the lowercase SHA-256 of the previous line's exact UTF-8 bytes (without its newline), or 64 zeros for seq 1; seq is consecutive from 1. The chain makes accidental edits, removed lines and reordering evident; it does not protect against the server administrator, and dropping the newest lines is only evident against a recorded head. Also apply strict runtime parsing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventVersion", "seq", "at", "actor", "type", "subject", "prev"],
  "properties": {
    "eventVersion": {"const": 1},
    "seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "at": {"$ref": "#/$defs/utc"},
    "actor": {"$ref": "#/$defs/ref"},
    "type": {
      "enum": ["capture.add", "mark.create", "mark.edit", "mark.accept", "mark.reject", "mark.withdraw",
        "snapshot.publish", "taxonomy.change", "governance.change", "prefs.change", "exception.grant", "exception.revoke"]
    },
    "subject": {"type": "string", "minLength": 1, "maxLength": 270, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(@[1-9][0-9]{0,9})?(?![\\s\\S])"},
    "digest": {"$ref": "#/$defs/sha256"},
    "prev": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,7})?Z(?![\\s\\S])"
    }
  }
}
