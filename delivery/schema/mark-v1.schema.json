{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersader.github.io/cleanyfin/schema/v1/mark.schema.json",
  "title": "Cleanyfin household mark v1",
  "$comment": "One revision of a mark a reviewer refines. Each edit is a new rev; old revs are kept. Acceptance is an audit-event-v1 naming ref@rev and contentSha256, not this state field alone. Also apply strict runtime parsing. Schema does not check duplicate keys, lexical integer spelling, startMs < endMs, digest correspondence, or that subcategory rolls up to category.",
  "type": "object",
  "additionalProperties": false,
  "required": ["markVersion", "ref", "rev", "bindingRev", "startMs", "endMs", "boundsSource", "state", "provenance", "editedBy"],
  "properties": {
    "markVersion": {"const": 1},
    "ref": {"$ref": "#/$defs/ref"},
    "rev": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "bindingRev": {"$ref": "#/$defs/ref"},
    "startMs": {"$ref": "#/$defs/nonnegative"},
    "endMs": {"$ref": "#/$defs/positive"},
    "boundsSource": {
      "$comment": "capture-window: only the capture's search window, never acceptable. reviewer: exact bounds a person set on the source clock.",
      "enum": ["capture-window", "reviewer"]
    },
    "category": {"$ref": "#/$defs/category"},
    "subcategory": {"$ref": "#/$defs/conceptId"},
    "severity": {"type": "integer", "minimum": 0, "maximum": 3},
    "action": {"enum": ["skip", "cut", "mute", "mark"]},
    "state": {"enum": ["proposed", "accepted", "rejected", "withdrawn"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "method", "by", "license"],
      "properties": {
        "from": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "method": {"enum": ["live", "refined", "import:mcf", "import:edl", "auto:subtitle", "auto:service"]},
        "by": {"$ref": "#/$defs/ref"},
        "license": {"$ref": "#/$defs/ref"}
      }
    },
    "editedBy": {"$ref": "#/$defs/ref"},
    "contentSha256": {"$ref": "#/$defs/sha256"}
  },
  "dependentRequired": {
    "contentSha256": ["category", "severity", "action"],
    "category": ["severity", "action", "contentSha256"],
    "severity": ["category", "action", "contentSha256"],
    "action": ["category", "severity", "contentSha256"]
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "accepted"}}},
      "then": {"required": ["category", "severity", "action", "contentSha256"], "properties": {"boundsSource": {"const": "reviewer"}}}
    }
  ],
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "category": {
      "enum": ["profanity", "sexual_dialogue", "sex_scene", "nudity", "violence", "gore", "disturbing", "substance_use", "crude"]
    },
    "conceptId": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*:[a-z0-9][a-z0-9_-]*(?![\\s\\S])"}
  }
}
